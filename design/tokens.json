{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "dusk": { "$type": "color", "$value": "#0F1330", "$description": "ground, page background, fog" },
    "dusk-2": { "$type": "color", "$value": "#171C42", "$description": "panels at 86% opacity over the city" },
    "haze": { "$type": "color", "$value": "#2A3166", "$description": "hairlines, inactive tracks, roads" },
    "mist": { "$type": "color", "$value": "#9AA3CF", "$description": "secondary text" },
    "paper": { "$type": "color", "$value": "#EEF0FB", "$description": "primary text" },
    "lamp": { "$type": "color", "$value": "#FFB547", "$description": "ordered; primary action" },
    "tube": { "$type": "color", "$value": "#A6F0DA", "$description": "stores, riders, unaware city" },
    "chatter": { "$type": "color", "$value": "#C8B6FF", "$description": "word of mouth" },
    "sindoor": { "$type": "color", "$value": "#FF5468", "$description": "stockouts, errors" },
    "monsoon": { "$type": "color", "$value": "#6F8CC9", "$description": "rain" }
  },
  "sky": {
    "zenith": { "$type": "color", "$value": "#04061A", "$description": "sky overhead" },
    "mid": { "$type": "color", "$value": "#0B0F2E", "$description": "sky above the horizon" },
    "horizon": { "$type": "color", "$value": "#231F4E", "$description": "distant horizon glow; far fog drifts toward it" },
    "band": { "$type": "color", "$value": "#4A3C7E", "$description": "violet band at the horizon" }
  },
  "light": {
    "ground": { "$type": "color", "$value": "#F3F4FB" },
    "text": { "$type": "color", "$value": "#0F1330" },
    "muted": { "$type": "color", "$value": "#4A5288" },
    "line": { "$type": "color", "$value": "#D5D9EE" },
    "lamp-ink": { "$type": "color", "$value": "#9A5B00", "$description": "lamp darkened for text on light ground" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Big Shoulders", "Arial Narrow", "Roboto Condensed", "sans-serif"] },
    "body": { "$type": "fontFamily", "$value": ["Atkinson Hyperlegible Next", "Segoe UI", "system-ui", "sans-serif"] }
  },
  "size": {
    "12": { "$type": "dimension", "$value": "12px" },
    "14": { "$type": "dimension", "$value": "14px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "18": { "$type": "dimension", "$value": "18px" },
    "21": { "$type": "dimension", "$value": "21px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "44": { "$type": "dimension", "$value": "44px" },
    "60": { "$type": "dimension", "$value": "60px" },
    "80": { "$type": "dimension", "$value": "80px" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "14px" },
    "input": { "$type": "dimension", "$value": "10px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "docked": { "$type": "dimension", "$value": "0px" }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px", "color": "rgba(5,7,20,0.45)" } }
  },
  "motion": {
    "card": { "$type": "duration", "$value": "220ms" },
    "sheet": { "$type": "duration", "$value": "260ms" },
    "intro": { "$type": "duration", "$value": "2500ms" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  },
  "city": {
    "resident-unaware-intensity": { "$type": "number", "$value": 0.2 },
    "resident-aware-intensity": { "$type": "number", "$value": 0.5 },
    "resident-ordered-intensity": { "$type": "number", "$value": 0.9 },
    "flare-sim-hours": { "$type": "number", "$value": 6 },
    "arc-travel-sim-hours": { "$type": "number", "$value": 3 }
  }
}
