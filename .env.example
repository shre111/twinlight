EMAIL_FROM=
SMTP_URL=

RUNNER_URL=http://localhost:8081
MINDS_URL=http://localhost:8082

ANTHROPIC_API_KEY=
LLM_MODEL_ELICIT=claude-haiku-5-5
LLM_MODEL_INTERVIEW=claude-sonnet-5-5
