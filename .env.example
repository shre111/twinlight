# Dev only: a folder of generated city packs (one subfolder per pack) served to /dev/fixture and
# /dev/stage?pack=<name>. Defaults to data/cache/packs, where `just fixture-pack` writes
# (apps/web/.env.development); relative paths start from apps/web.
TWL_PACK_DIR=
# Tests only, absolute path: one generated pack folder for the stage's opt-in pack test.
TWL_TEST_PACK_DIR=
